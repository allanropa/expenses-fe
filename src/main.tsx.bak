import { StrictMode, type FormEvent, type ReactNode, useEffect, useState } from "react";
import { createRoot } from "react-dom/client";
import { api } from "./api";
import type { Account, AccountMovement, Budget, Card, Category, Dashboard, Loan, Purchase, Session, Transaction } from "./types";
import "./styles.css";

type View = "dashboard" | "transactions" | "accounts" | "cards" | "loans" | "budgets" | "settings";

function money(value: string | number, currency: string) {
  return new Intl.NumberFormat("es-CO", {
    style: "currency",
    currency,
    maximumFractionDigits: currency === "COP" ? 0 : 2,
  }).format(Number(value));
}

function Modal({ open, title, onClose, children }: { open: boolean; title: string; onClose: () => void; children: ReactNode }) {
  useEffect(() => {
    if (!open) return;
    const closeOnEscape = (event: KeyboardEvent) => { if (event.key === "Escape") onClose(); };
    window.addEventListener("keydown", closeOnEscape);
    return () => window.removeEventListener("keydown", closeOnEscape);
  }, [open, onClose]);
  if (!open) return null;
  return <div className="modal-backdrop" role="presentation" onClick={event => { if (event.target === event.currentTarget) onClose(); }}><section className="modal" role="dialog" aria-modal="true" aria-label={title}><div className="modal-header"><h3>{title}</h3><button className="modal-close" onClick={onClose} aria-label="Cerrar">×</button></div>{children}</section></div>;
}

function ActionMenu({ onDetails, onConfigure, onDelete }: { onDetails: () => void; onConfigure?: () => void; onDelete?: () => void }) {
  return <details className="item-menu"><summary aria-label="Acciones">•••</summary><div className="item-menu-panel"><button onClick={onDetails}>Ver detalles</button>{onConfigure && <button onClick={onConfigure}>Configurar</button>}{onDelete && <button onClick={onDelete}>Anular</button>}</div></details>;
}

function Auth({ onSession }: { onSession: (session: Session) => void }) {
  const [registering, setRegistering] = useState(false);
  const [form, setForm] = useState({ email: "", password: "", display_name: "" });
  const [error, setError] = useState("");

  async function submit(event: FormEvent) {
    event.preventDefault();
    setError("");
    try {
      const session = await api<Session>(registering ? "/api/auth/register" : "/api/auth/login", {
        method: "POST",
        body: JSON.stringify(form),
      });
      onSession(session);
    } catch (requestError) {
      setError(requestError instanceof Error ? requestError.message : "Error de autenticación");
    }
  }

  return (
    <main className="auth-shell">
      <section className="auth-panel">
        <p className="eyebrow">Mis finanzas</p>
        <h1>{registering ? "Crea tu espacio financiero" : "Vuelve a tus números"}</h1>
        <p className="muted">Una vista clara de tu dinero, tus obligaciones y tus hábitos.</p>
        <form onSubmit={submit} className="stack">
          {registering && <label>Nombre<input required value={form.display_name} onChange={event => setForm({ ...form, display_name: event.target.value })} /></label>}
          <label>Correo<input required type="email" value={form.email} onChange={event => setForm({ ...form, email: event.target.value })} /></label>
          <label>Contraseña<input required minLength={8} type="password" value={form.password} onChange={event => setForm({ ...form, password: event.target.value })} /></label>
          {error && <p className="error">{error}</p>}
          <button>{registering ? "Crear cuenta" : "Iniciar sesión"}</button>
        </form>
        <button className="link-button" onClick={() => setRegistering(!registering)}>{registering ? "Ya tengo una cuenta" : "Crear una cuenta"}</button>
      </section>
    </main>
  );
}

function DashboardView() {
  const [data, setData] = useState<Dashboard | null>(null);
  useEffect(() => { api<Dashboard>("/api/dashboard").then(setData).catch(() => undefined); }, []);
  if (!data) return <p className="muted">Cargando resumen...</p>;
  const totals = (values: Record<string, string>) => Object.entries(values).map(([currency, value]) => <span key={currency}>{money(value, currency)}</span>);
  return <>
    <header className="page-heading"><div><p className="eyebrow">Resumen del mes</p><h2>Tu posición financiera</h2></div></header>
    <section className="metric-grid">
      <article className="metric"><span>Ingresos</span><strong>{totals(data.income_by_currency)}</strong></article>
      <article className="metric"><span>Consumo</span><strong>{totals(data.consumption_by_currency)}</strong></article>
      <article className="metric"><span>Cuentas</span><strong>{data.accounts.length}</strong></article>
      <article className="metric"><span>Deuda</span><strong>{data.card_debt.length + data.loan_debt.length}</strong></article>
    </section>
    <div className="split-grid">
      <section className="card"><h3>Liquidez</h3>{data.accounts.map(account => <div className="row" key={account.id}><span>{account.name}</span><b>{money(account.balance, account.currency)}</b></div>)}</section>
      <section className="card"><h3>Deuda</h3>
        {data.card_debt.length === 0 && data.loan_debt.length === 0 && <p className="muted">No hay deuda registrada.</p>}
        {data.card_debt.map((item, index) => <div className="row" key={`card-${item.card_id}-${item.currency}-${index}`}><span>{item.card_name} · {item.currency}</span><b>{money(item.amount, item.currency)}</b></div>)}
        {data.loan_debt.map(item => <div className="row" key={`loan-${item.id}`}><span>{item.name} · {item.currency}</span><b>{money(item.outstanding, item.currency)}</b></div>)}
      </section>
    </div>
    {data.budgets.length > 0 && <section className="card" style={{ marginTop: 12 }}><h3>Presupuestos</h3>
      {data.budgets.map(item => { const pct = Math.min(Number(item.percentage_used), 200); return <div key={item.budget_id} style={{ marginBottom: 8 }}><div className="row"><span>{item.name}<small>{item.percentage_used}% usado · {item.period_start} a {item.period_end}</small></span><b>{money(item.actual_spending, item.currency)} / {money(item.accumulated_budget, item.currency)}</b></div><div className="budget-progress"><div style={{ width: `${pct}%` }} /></div></div>; })}
    </section>}
    {data.recent_transactions.length > 0 && <section className="card list-card" style={{ marginTop: 12 }}><h3>Últimos movimientos</h3>
      {data.recent_transactions.map(item => <div className="list-item" key={item.id}><div><strong>{item.description || item.transaction_type}</strong><small>{item.transaction_date} · {item.currency} · {item.source || (item.payment_method === "credit" ? "Tarjeta" : "Cuenta")}</small></div><b className={item.transaction_type === "expense" ? "negative" : "positive"}>{item.transaction_type === "expense" ? "-" : "+"}{money(item.amount, item.currency)}</b></div>)}
    </section>}
  </>;
}

function AccountDetailsPanel({ csrf, initialId, onChanged }: { csrf: string; initialId?: string; onChanged: () => void }) {
  const [accountId, setAccountId] = useState(initialId ?? "");
  const [detail, setDetail] = useState<Account | null>(null);
  const [movements, setMovements] = useState<AccountMovement[]>([]);
  const [form, setForm] = useState({ target_balance: "", adjustment_date: new Date().toISOString().slice(0, 10), description: "" });
  const [editName, setEditName] = useState("");
  const [editDesc, setEditDesc] = useState("");
  useEffect(() => { if (initialId) { setAccountId(initialId); api<Account>(`/api/accounts/${initialId}`).then(value => { setDetail(value); setEditName(value.name); setEditDesc(value.description ?? ""); }); api<AccountMovement[]>(`/api/accounts/${initialId}/movements`).then(setMovements); } }, [initialId]);
  async function adjust(event: FormEvent) { event.preventDefault(); if (!accountId) return; await api(`/api/accounts/${accountId}/balance-adjustments`, { method: "POST", csrf, headers: { "Idempotency-Key": crypto.randomUUID() }, body: JSON.stringify(form) }); setForm({ ...form, target_balance: "", description: "" }); api<Account>(`/api/accounts/${accountId}`).then(value => { setDetail(value); setEditName(value.name); setEditDesc(value.description ?? ""); }); api<AccountMovement[]>(`/api/accounts/${accountId}/movements`).then(setMovements); }
  async function saveProfile(event: FormEvent) { event.preventDefault(); await api(`/api/accounts/${accountId}`, { method: "PATCH", csrf, body: JSON.stringify({ name: editName, description: editDesc || null }) }); api<Account>(`/api/accounts/${accountId}`).then(value => { setDetail(value); setEditName(value.name); setEditDesc(value.description ?? ""); }); onChanged(); }
  async function archive() { await api(`/api/accounts/${accountId}/archive`, { method: "POST", csrf }); onChanged(); }
  return <section className="card detail-panel">{detail && <><div className="detail-heading"><div><p className="eyebrow">Detalle</p><h3>{detail.name}</h3><p className="muted">{detail.account_type} · {detail.currency}</p></div></div><div className="detail-grid"><div><small>Saldo actual</small><strong>{money(detail.current_balance, detail.currency)}</strong></div></div><h4>Editar cuenta</h4><form className="inline-form" onSubmit={saveProfile}><label>Nombre<input value={editName} onChange={event => setEditName(event.target.value)} /></label><label>Descripción<input value={editDesc} onChange={event => setEditDesc(event.target.value)} /></label><button>Guardar</button></form><h4>Ajustar saldo</h4><form className="inline-form" onSubmit={adjust}><label>Nuevo saldo<input required type="number" step="0.01" value={form.target_balance} onChange={event => setForm({ ...form, target_balance: event.target.value })} /></label><label>Fecha<input required type="date" value={form.adjustment_date} onChange={event => setForm({ ...form, adjustment_date: event.target.value })} /></label><label>Descripción<input value={form.description} onChange={event => setForm({ ...form, description: event.target.value })} /></label><button>Registrar ajuste</button></form><h4>Movimientos</h4>{movements.slice(0, 8).map(item => <div className="row" key={item.id}><span>{item.effective_date} · {item.operation_type}{item.description ? ` · ${item.description}` : ""}</span><b>{money(item.amount, item.currency)}</b></div>)}<button type="button" className="danger-button" onClick={archive} style={{ marginTop: 16 }}>Archivar cuenta</button></>}</section>;
}

function AccountsWorkspace({ csrf }: { csrf: string }) {
  const [accounts, setAccounts] = useState<Account[]>([]);
  const [form, setForm] = useState({ name: "", currency: "COP", account_type: "checking", opening_balance: "0", opening_balance_date: new Date().toISOString().slice(0, 10) });
  const load = () => api<Account[]>("/api/accounts").then(setAccounts);
  useEffect(() => { load(); }, []);
  async function submit(event: FormEvent) { event.preventDefault(); await api("/api/accounts", { method: "POST", csrf, body: JSON.stringify(form) }); setForm({ ...form, name: "", opening_balance: "0" }); load(); }
  return <><header className="page-heading"><div><p className="eyebrow">Liquidez</p><h2>Cuentas y efectivo</h2></div></header><div className="split-grid"><section className="card"><h3>Nueva cuenta</h3><form className="stack" onSubmit={submit}><label>Nombre<input required value={form.name} onChange={event => setForm({ ...form, name: event.target.value })} /></label><label>Tipo<select value={form.account_type} onChange={event => setForm({ ...form, account_type: event.target.value })}><option value="checking">Corriente</option><option value="savings">Ahorros</option><option value="cash">Efectivo</option></select></label><label>Moneda<select value={form.currency} onChange={event => setForm({ ...form, currency: event.target.value })}><option>COP</option><option>USD</option></select></label><button>Agregar cuenta</button></form></section><section className="card"><h3>Tus cuentas</h3>{accounts.map(account => <div className="row" key={account.id}><span>{account.name}<small>{account.currency} · {account.account_type}</small></span><b>{money(account.current_balance, account.currency)}</b></div>)}</section></div></>;
}

function AccountsListContent({ csrf }: { csrf: string }) {
  const [accounts, setAccounts] = useState<Account[]>([]);
  const [addOpen, setAddOpen] = useState(false);
  const [detailId, setDetailId] = useState<string | null>(null);
  const [form, setForm] = useState({ name: "", currency: "COP", account_type: "checking", opening_balance: "0", opening_balance_date: new Date().toISOString().slice(0, 10) });
  const load = () => api<Account[]>("/api/accounts").then(setAccounts);
  useEffect(() => { load(); }, []);
  async function submit(event: FormEvent) { event.preventDefault(); await api("/api/accounts", { method: "POST", csrf, body: JSON.stringify(form) }); setAddOpen(false); setForm({ ...form, name: "", opening_balance: "0" }); load(); }
  const totals = accounts.reduce<Record<string, number>>((result, account) => { result[account.currency] = (result[account.currency] ?? 0) + Number(account.current_balance); return result; }, {});
  return <><header className="page-heading"><div><p className="eyebrow">Liquidez</p><h2>Cuentas</h2></div><button onClick={() => setAddOpen(true)}>Agregar cuenta</button></header><section className="summary-strip"><strong>{accounts.length} cuentas</strong>{Object.entries(totals).map(([currency, amount]) => <span key={currency}>{currency}: {money(amount, currency)}</span>)}</section><section className="card list-card">{accounts.length === 0 ? <p className="muted">No hay cuentas registradas.</p> : accounts.map(account => <div className="list-item" key={account.id}><div><strong>{account.name}</strong><small>{account.account_type} · {account.currency}</small></div><b>{money(account.current_balance, account.currency)}</b><ActionMenu onDetails={() => setDetailId(String(account.id))} onConfigure={() => setDetailId(String(account.id))} /></div>)}</section><Modal open={addOpen} title="Agregar cuenta" onClose={() => setAddOpen(false)}><form className="stack" onSubmit={submit}><label>Nombre<input required value={form.name} onChange={event => setForm({ ...form, name: event.target.value })} /></label><label>Tipo<select value={form.account_type} onChange={event => setForm({ ...form, account_type: event.target.value })}><option value="checking">Corriente</option><option value="savings">Ahorros</option><option value="cash">Efectivo</option></select></label><label>Moneda<select value={form.currency} onChange={event => setForm({ ...form, currency: event.target.value })}><option>COP</option><option>USD</option></select></label><button>Guardar cuenta</button></form></Modal><Modal open={Boolean(detailId)} title="Detalle y configuración de cuenta" onClose={() => setDetailId(null)}><AccountDetailsPanel csrf={csrf} initialId={detailId ?? undefined} onChanged={load} /></Modal></>;
}

function AccountsView({ csrf }: { csrf: string }) {
  return <AccountsListContent csrf={csrf} />;
}

function MovementsListView({ csrf }: { csrf: string }) {
  const [items, setItems] = useState<Transaction[]>([]);
  const [accounts, setAccounts] = useState<Account[]>([]);
  const [categories, setCategories] = useState<Category[]>([]);
  const [addOpen, setAddOpen] = useState(false);
  const [detail, setDetail] = useState<Transaction | null>(null);
  const [form, setForm] = useState({ transaction_type: "expense", amount: "", currency: "COP", transaction_date: new Date().toISOString().slice(0, 10), account_id: "", category_id: "", description: "" });
  const load = () => api<Transaction[]>("/api/transactions").then(setItems);
  useEffect(() => { load(); api<Account[]>("/api/accounts").then(values => { setAccounts(values); if (values[0]) setForm(value => ({ ...value, account_id: String(values[0].id), currency: values[0].currency })); }); api<Category[]>("/api/categories").then(values => { setCategories(values); const category = values.find(item => item.kind !== "income"); if (category) setForm(value => ({ ...value, category_id: String(category.id) })); }); }, []);
  async function submit(event: FormEvent) { event.preventDefault(); await api("/api/transactions", { method: "POST", csrf, headers: { "Idempotency-Key": crypto.randomUUID() }, body: JSON.stringify({ ...form, account_id: Number(form.account_id), category_id: Number(form.category_id) }) }); setAddOpen(false); setForm({ ...form, amount: "", description: "" }); load(); }
  async function remove(id: number) { await api(`/api/transactions/${id}`, { method: "DELETE", csrf }); load(); }
  const totals = items.reduce<Record<string, number>>((result, item) => { if (item.transaction_type === "expense") result[item.currency] = (result[item.currency] ?? 0) + Number(item.amount); return result; }, {});
  return <><header className="page-heading"><div><p className="eyebrow">Movimientos</p><h2>Transacciones</h2></div><button onClick={() => setAddOpen(true)}>Agregar movimiento</button></header><section className="summary-strip"><strong>{items.length} movimientos</strong>{Object.entries(totals).map(([currency, amount]) => <span key={currency}>Gastos {currency}: {money(amount, currency)}</span>)}</section><section className="card list-card">{items.length === 0 ? <p className="muted">No hay movimientos registrados.</p> : items.map(item => <div className="list-item" key={item.id}><div><strong>{item.description || item.transaction_type}</strong><small>{item.transaction_date} · {item.currency}</small></div><b className={item.transaction_type === "expense" ? "negative" : "positive"}>{item.transaction_type === "expense" ? "-" : "+"}{money(item.amount, item.currency)}</b><ActionMenu onDetails={() => setDetail(item)} onDelete={() => remove(item.id)} /></div>)}</section><Modal open={addOpen} title="Agregar movimiento" onClose={() => setAddOpen(false)}><form className="stack" onSubmit={submit}><label>Tipo<select value={form.transaction_type} onChange={event => setForm({ ...form, transaction_type: event.target.value })}><option value="expense">Gasto</option><option value="income">Ingreso</option></select></label><label>Monto<input required type="number" min="0" step="0.01" value={form.amount} onChange={event => setForm({ ...form, amount: event.target.value })} /></label><label>Cuenta<select required value={form.account_id} onChange={event => { const account = accounts.find(item => item.id === Number(event.target.value)); setForm({ ...form, account_id: event.target.value, currency: account?.currency ?? form.currency }); }}>{accounts.map(account => <option key={account.id} value={account.id}>{account.name} ({account.currency})</option>)}</select></label><label>Categoría<select required value={form.category_id} onChange={event => setForm({ ...form, category_id: event.target.value })}>{categories.map(category => <option key={category.id} value={category.id}>{category.name}</option>)}</select></label><label>Fecha<input required type="date" value={form.transaction_date} onChange={event => setForm({ ...form, transaction_date: event.target.value })} /></label><label>Descripción<input value={form.description} onChange={event => setForm({ ...form, description: event.target.value })} /></label><button>Guardar movimiento</button></form></Modal><Modal open={Boolean(detail)} title="Detalle del movimiento" onClose={() => setDetail(null)}>{detail && <div className="detail-grid"><div><small>Tipo</small><strong>{detail.transaction_type}</strong></div><div><small>Monto</small><strong>{money(detail.amount, detail.currency)}</strong></div><div><small>Fecha</small><strong>{detail.transaction_date}</strong></div><div><small>Estado</small><strong>{detail.status}</strong></div></div>}</Modal></>;
}

function UnifiedMovementsView({ csrf }: { csrf: string }) {
  const [transactions, setTransactions] = useState<Transaction[]>([]);
  const [accounts, setAccounts] = useState<Account[]>([]);
  const [cards, setCards] = useState<Card[]>([]);
  const [categories, setCategories] = useState<Category[]>([]);
  const [form, setForm] = useState({ kind: "debit", transaction_type: "expense", amount: "", currency: "COP", transaction_date: new Date().toISOString().slice(0, 10), account_id: "", card_id: "", category_id: "", installments_count: "1", description: "" });
  const load = () => api<Transaction[]>("/api/transactions").then(setTransactions);
  useEffect(() => { load(); api<Account[]>("/api/accounts").then(values => { setAccounts(values); if (values[0]) setForm(value => ({ ...value, account_id: String(values[0].id), currency: values[0].currency })); }); api<Card[]>("/api/cards").then(values => { setCards(values); if (values[0]) setForm(value => ({ ...value, card_id: String(values[0].id), currency: values[0].currencies[0]?.currency ?? value.currency })); }); api<Category[]>("/api/categories").then(values => { setCategories(values); const category = values.find(item => item.kind !== "income"); if (category) setForm(value => ({ ...value, category_id: String(category.id) })); }); }, []);
  const selectedCard = cards.find(card => card.id === Number(form.card_id));
  const cardCurrencies = selectedCard?.currencies.map(item => item.currency) ?? [];
  async function submit(event: FormEvent) { event.preventDefault(); if (form.kind === "credit") { await api(`/api/cards/${form.card_id}/purchases`, { method: "POST", csrf, headers: { "Idempotency-Key": crypto.randomUUID() }, body: JSON.stringify({ card_id: Number(form.card_id), category_id: Number(form.category_id), amount: form.amount, currency: form.currency, purchase_date: form.transaction_date, installments_count: Number(form.installments_count), description: form.description }) }); } else { await api("/api/transactions", { method: "POST", csrf, headers: { "Idempotency-Key": crypto.randomUUID() }, body: JSON.stringify({ transaction_type: form.transaction_type, amount: form.amount, currency: form.currency, transaction_date: form.transaction_date, account_id: Number(form.account_id), category_id: Number(form.category_id), description: form.description }) }); } setForm(value => ({ ...value, amount: "", description: "" })); load(); }
  const totals = transactions.reduce<Record<string, number>>((result, item) => { if (item.transaction_type === "expense") result[item.currency] = (result[item.currency] ?? 0) + Number(item.amount); return result; }, {});
  return <><header className="page-heading"><div><p className="eyebrow">Movimientos</p><h2>Transacciones</h2></div></header><section className="summary-strip"><strong>{transactions.length} movimientos</strong>{Object.entries(totals).map(([currency, amount]) => <span key={currency}>Gastos {currency}: {money(amount, currency)}</span>)}</section><div className="split-grid"><section className="card"><h3>Agregar movimiento</h3><form className="stack" onSubmit={submit}><label>Medio<select value={form.kind} onChange={event => setForm({ ...form, kind: event.target.value, transaction_type: event.target.value === "credit" ? "expense" : form.transaction_type })}><option value="debit">Débito / cuenta</option><option value="credit">Crédito / tarjeta</option></select></label>{form.kind === "debit" ? <><label>Tipo<select value={form.transaction_type} onChange={event => setForm({ ...form, transaction_type: event.target.value })}><option value="expense">Gasto</option><option value="income">Ingreso</option></select></label><label>Cuenta<select required value={form.account_id} onChange={event => { const account = accounts.find(item => item.id === Number(event.target.value)); setForm({ ...form, account_id: event.target.value, currency: account?.currency ?? form.currency }); }}>{accounts.map(account => <option key={account.id} value={account.id}>{account.name} ({account.currency})</option>)}</select></label></> : <><label>Tarjeta<select required value={form.card_id} onChange={event => { const card = cards.find(item => item.id === Number(event.target.value)); setForm({ ...form, card_id: event.target.value, currency: card?.currencies[0]?.currency ?? form.currency }); }}>{cards.map(card => <option key={card.id} value={card.id}>{card.name}</option>)}</select></label><label>Moneda<select required value={form.currency} onChange={event => setForm({ ...form, currency: event.target.value })}>{cardCurrencies.map(currency => <option key={currency}>{currency}</option>)}</select></label><label>Cuotas<input required type="number" min="1" max="120" value={form.installments_count} onChange={event => setForm({ ...form, installments_count: event.target.value })} /></label></>}<label>Monto<input required type="number" min="0" step="0.01" value={form.amount} onChange={event => setForm({ ...form, amount: event.target.value })} /></label><label>Categoría<select required value={form.category_id} onChange={event => setForm({ ...form, category_id: event.target.value })}>{categories.filter(category => category.kind !== "income").map(category => <option key={category.id} value={category.id}>{category.name}</option>)}</select></label><label>Fecha<input required type="date" value={form.transaction_date} onChange={event => setForm({ ...form, transaction_date: event.target.value })} /></label><label>Descripción<input required value={form.description} onChange={event => setForm({ ...form, description: event.target.value })} /></label><button disabled={form.kind === "credit" && cards.length === 0}>Guardar movimiento</button></form></section><section className="card list-card"><h3>Historial</h3>{transactions.length === 0 ? <p className="muted">No hay movimientos registrados.</p> : transactions.map(item => <div className="list-item" key={item.id}><div><strong>{item.description || item.transaction_type}</strong><small>{item.transaction_date} · {item.currency} · {item.payment_method === "credit" ? "Tarjeta" : "Cuenta"}</small></div><b className={item.transaction_type === "expense" ? "negative" : "positive"}>{item.transaction_type === "expense" ? "-" : "+"}{money(item.amount, item.currency)}</b></div>)}</section></div></>;
}

function TransactionsView({ csrf }: { csrf: string }) {
  const [transactions, setTransactions] = useState<Transaction[]>([]);
  const [accounts, setAccounts] = useState<Account[]>([]);
  const [categories, setCategories] = useState<Category[]>([]);
  const [form, setForm] = useState({ transaction_type: "expense", amount: "", currency: "COP", transaction_date: new Date().toISOString().slice(0, 10), account_id: "", category_id: "", description: "" });
  const load = () => api<Transaction[]>("/api/transactions").then(setTransactions);
  useEffect(() => {
    load();
    api<Account[]>("/api/accounts").then(items => { setAccounts(items); if (items[0]) setForm(value => ({ ...value, account_id: String(items[0].id), currency: items[0].currency })); });
    api<Category[]>("/api/categories").then(items => { setCategories(items); const category = items.find(item => item.kind !== "income"); if (category) setForm(value => ({ ...value, category_id: String(category.id) })); });
  }, []);
  async function submit(event: FormEvent) { event.preventDefault(); await api("/api/transactions", { method: "POST", csrf, headers: { "Idempotency-Key": crypto.randomUUID() }, body: JSON.stringify({ ...form, account_id: Number(form.account_id), category_id: Number(form.category_id) }) }); setForm({ ...form, amount: "", description: "" }); load(); }
  async function remove(id: number) { await api(`/api/transactions/${id}`, { method: "DELETE", csrf }); load(); }
  return <><header className="page-heading"><div><p className="eyebrow">Historial</p><h2>Movimientos</h2></div></header><div className="split-grid"><section className="card"><h3>Registrar movimiento</h3><form className="stack" onSubmit={submit}><label>Tipo<select value={form.transaction_type} onChange={event => setForm({ ...form, transaction_type: event.target.value })}><option value="expense">Gasto</option><option value="income">Ingreso</option></select></label><label>Monto<input required type="number" min="0" step="0.01" value={form.amount} onChange={event => setForm({ ...form, amount: event.target.value })} /></label><label>Cuenta<select required value={form.account_id} onChange={event => { const account = accounts.find(item => item.id === Number(event.target.value)); setForm({ ...form, account_id: event.target.value, currency: account?.currency ?? form.currency }); }}>{accounts.map(account => <option key={account.id} value={account.id}>{account.name} ({account.currency})</option>)}</select></label><label>Categoría<select required value={form.category_id} onChange={event => setForm({ ...form, category_id: event.target.value })}>{categories.map(category => <option key={category.id} value={category.id}>{category.name}</option>)}</select></label><label>Fecha<input required type="date" value={form.transaction_date} onChange={event => setForm({ ...form, transaction_date: event.target.value })} /></label><label>Descripción<input value={form.description} onChange={event => setForm({ ...form, description: event.target.value })} /></label><button>Guardar movimiento</button></form></section><section className="card"><h3>Movimientos recientes</h3>{transactions.map(item => <div className="row" key={item.id}><span>{item.description || item.transaction_type}<small>{item.transaction_date} · {item.currency}</small></span><b className={item.transaction_type === "expense" ? "negative" : "positive"}>{item.transaction_type === "expense" ? "-" : "+"}{money(item.amount, item.currency)}</b><button className="link-button" onClick={() => remove(item.id)}>Anular</button></div>)}</section></div></>;
}

function InterestConfigPanel({ csrf }: { csrf: string }) {
  const [cards, setCards] = useState<Card[]>([]);
  const [cardId, setCardId] = useState("");
  const [currency, setCurrency] = useState("COP");
  const [monthlyRate, setMonthlyRate] = useState("");
  const [effectiveFrom, setEffectiveFrom] = useState(new Date().toISOString().slice(0, 10));
  const [effectiveTo, setEffectiveTo] = useState("");
  const load = () => api<Card[]>("/api/cards").then(items => { setCards(items); if (!cardId && items[0]) setCardId(String(items[0].id)); });
  useEffect(() => { load(); }, []);
  const selected = cards.find(card => card.id === Number(cardId));
  const currencies = selected?.currencies.map(item => item.currency) ?? ["COP", "USD"];
  useEffect(() => { if (currencies.length > 0 && !currencies.includes(currency)) setCurrency(currencies[0]); }, [cardId, cards]);
  async function submit(event: FormEvent) {
    event.preventDefault();
    if (!cardId || !monthlyRate) return;
    await api(`/api/cards/${cardId}/interest-rates`, {
      method: "POST",
      csrf,
      body: JSON.stringify({
        currency: currency || null,
        monthly_rate: String(Number(monthlyRate) / 100),
        effective_from: effectiveFrom,
        effective_to: effectiveTo || null,
      }),
    });
    setMonthlyRate("");
  }
  return <section className="card interest-panel"><div><p className="eyebrow">Financiación</p><h3>Configurar interés de tarjeta</h3><p className="muted">La tasa se aplica por cuota. Una compra de una sola cuota queda sin interés. Puedes usar hasta 8 decimales porcentuales.</p></div><form className="interest-form" onSubmit={submit}><label>Tarjeta<select required value={cardId} onChange={event => setCardId(event.target.value)}>{cards.map(card => <option key={card.id} value={card.id}>{card.name}</option>)}</select></label><label>Moneda<select value={currency} onChange={event => setCurrency(event.target.value)}>{currencies.map(item => <option key={item}>{item}</option>)}</select></label><label>Tasa mensual (%)<input required type="number" min="0" step="0.00000001" placeholder="2.12345678" value={monthlyRate} onChange={event => setMonthlyRate(event.target.value)} /></label><label>Vigente desde<input required type="date" value={effectiveFrom} onChange={event => setEffectiveFrom(event.target.value)} /></label><label>Vigente hasta<input type="date" value={effectiveTo} onChange={event => setEffectiveTo(event.target.value)} /></label><button disabled={!cardId}>Guardar tasa</button></form></section>;
}

function CardsWorkspace({ csrf }: { csrf: string }) {
  const [cards, setCards] = useState<Card[]>([]);
  const [accounts, setAccounts] = useState<Account[]>([]);
  const [categories, setCategories] = useState<Category[]>([]);
  const [purchases, setPurchases] = useState<Purchase[]>([]);
  const [selectedId, setSelectedId] = useState<number | null>(null);
  const [form, setForm] = useState({ name: "", issuing_bank: "", description: "", statement_closing_day: "15", currency: "COP", credit_limit: "" });
  const [purchase, setPurchase] = useState({ category_id: "", amount: "", installments_count: "1", purchase_date: new Date().toISOString().slice(0, 10), description: "" });
  const [payment, setPayment] = useState({ amount: "", source_account_id: "", source_amount: "", exchange_rate: "", payment_date: new Date().toISOString().slice(0, 10) });
  const load = () => api<Card[]>("/api/cards").then(items => { setCards(items); if (!selectedId && items[0]) setSelectedId(items[0].id); });
  useEffect(() => { load(); api<Account[]>("/api/accounts").then(setAccounts); api<Category[]>("/api/categories").then(items => { setCategories(items); if (items[0]) setPurchase(value => ({ ...value, category_id: String(items[0].id) })); }); }, []);
  useEffect(() => { if (selectedId) api<Purchase[]>(`/api/cards/${selectedId}/purchases`).then(setPurchases); }, [selectedId]);
  const selected = cards.find(card => card.id === selectedId);
  const selectedCurrency = selected?.currencies[0]?.currency ?? "COP";
  async function submit(event: FormEvent) { event.preventDefault(); await api("/api/cards", { method: "POST", csrf, body: JSON.stringify({ name: form.name, issuing_bank: form.issuing_bank || null, description: form.description || null, statement_closing_day: Number(form.statement_closing_day), currencies: [{ currency: form.currency, credit_limit: form.credit_limit || null }] }) }); setForm({ ...form, name: "" }); load(); }
  async function registerPurchase(event: FormEvent) { event.preventDefault(); if (!selected) return; await api(`/api/cards/${selected.id}/purchases`, { method: "POST", csrf, headers: { "Idempotency-Key": crypto.randomUUID() }, body: JSON.stringify({ ...purchase, card_id: selected.id, installments_count: Number(purchase.installments_count), category_id: Number(purchase.category_id), currency: selectedCurrency }) }); setPurchase({ ...purchase, amount: "", description: "" }); load(); }
  async function registerPayment(event: FormEvent) { event.preventDefault(); if (!selected) return; const source = accounts.find(account => account.id === Number(payment.source_account_id)); await api(`/api/cards/${selected.id}/payments`, { method: "POST", csrf, headers: { "Idempotency-Key": crypto.randomUUID() }, body: JSON.stringify({ card_id: selected.id, source_account_id: source?.id, obligation_amount: payment.amount, obligation_currency: selectedCurrency, source_amount: payment.source_amount || undefined, exchange_rate: payment.exchange_rate || undefined, payment_date: payment.payment_date }) }); setPayment({ ...payment, amount: "", source_amount: "", exchange_rate: "" }); load(); }
  return <><header className="page-heading"><div><p className="eyebrow">Obligaciones</p><h2>Tarjetas de crédito</h2></div></header><div className="split-grid"><section className="card"><h3>Nueva tarjeta</h3><form className="stack" onSubmit={submit}><label>Nombre<input required value={form.name} onChange={event => setForm({ ...form, name: event.target.value })} /></label><label>Día de corte<input required type="number" min="1" max="31" value={form.statement_closing_day} onChange={event => setForm({ ...form, statement_closing_day: event.target.value })} /></label><label>Moneda<select value={form.currency} onChange={event => setForm({ ...form, currency: event.target.value })}><option>COP</option><option>USD</option></select></label><button>Agregar tarjeta</button></form><h3 className="section-gap">Tus tarjetas</h3>{cards.map(card => <button className={selectedId === card.id ? "card-item selected-card" : "card-item"} key={card.id} onClick={() => setSelectedId(card.id)}><div className="row"><span>{card.name}<small>Corte día {card.statement_closing_day}</small></span><span className="tag">{card.currencies.map(item => item.currency).join(" · ")}</span></div>{card.currencies.map(item => <div className="row subrow" key={item.currency}><span>Deuda {item.currency}</span><b>{money(item.outstanding_debt, item.currency)}</b></div>)}</button>)}</section><section className="card">{selected ? <><h3>Registrar compra en {selected.name}</h3><form className="stack" onSubmit={registerPurchase}><label>Categoría<select value={purchase.category_id} onChange={event => setPurchase({ ...purchase, category_id: event.target.value })}>{categories.filter(category => category.kind !== "income").map(category => <option key={category.id} value={category.id}>{category.name}</option>)}</select></label><label>Monto ({selectedCurrency})<input required type="number" min="0" step="0.01" value={purchase.amount} onChange={event => setPurchase({ ...purchase, amount: event.target.value })} /></label><label>Cuotas<input required type="number" min="1" max="120" value={purchase.installments_count} onChange={event => setPurchase({ ...purchase, installments_count: event.target.value })} /></label><label>Fecha<input required type="date" value={purchase.purchase_date} onChange={event => setPurchase({ ...purchase, purchase_date: event.target.value })} /></label><label>Descripción<input required value={purchase.description} onChange={event => setPurchase({ ...purchase, description: event.target.value })} /></label><button>Registrar compra</button></form><h3 className="section-gap">Registrar pago</h3><form className="stack" onSubmit={registerPayment}><label>Monto de obligación ({selectedCurrency})<input required type="number" min="0" step="0.01" value={payment.amount} onChange={event => setPayment({ ...payment, amount: event.target.value })} /></label><label>Cuenta origen<select required value={payment.source_account_id} onChange={event => setPayment({ ...payment, source_account_id: event.target.value })}>{accounts.map(account => <option key={account.id} value={account.id}>{account.name} ({account.currency})</option>)}</select></label><label>Monto origen si convierte<input type="number" min="0" step="0.01" value={payment.source_amount} onChange={event => setPayment({ ...payment, source_amount: event.target.value })} /></label><label>Tasa de conversión<input type="number" min="0" step="0.00000001" value={payment.exchange_rate} onChange={event => setPayment({ ...payment, exchange_rate: event.target.value })} /></label><label>Fecha<input required type="date" value={payment.payment_date} onChange={event => setPayment({ ...payment, payment_date: event.target.value })} /></label><button>Registrar pago</button></form><h3 className="section-gap">Compras</h3>{purchases.map(item => <div className="row" key={item.id}><span>{item.description}<small>{item.installments_count} cuotas · {item.purchase_date}</small></span><b>{money(item.amount, item.currency)}</b></div>)}</> : <p className="muted">Crea o selecciona una tarjeta.</p>}</section></div></>;
}

function CardArchivePanel({ csrf }: { csrf: string }) {
  const [cards, setCards] = useState<Card[]>([]);
  const [cardId, setCardId] = useState("");
  const [message, setMessage] = useState("");
  const load = () => api<Card[]>("/api/cards").then(items => { setCards(items); if (!cardId && items[0]) setCardId(String(items[0].id)); });
  useEffect(() => { load(); }, []);
  async function archive() {
    if (!cardId) return;
    await api(`/api/cards/${cardId}/archive`, { method: "POST", csrf });
    setMessage("Tarjeta archivada. Su historial se conserva.");
    setCardId("");
    load();
  }
  if (cards.length === 0) return null;
  return <section className="card archive-panel"><div><p className="eyebrow">Administración</p><h3>Archivar tarjeta</h3><p className="muted">Archivar la tarjeta la oculta de las nuevas operaciones, pero conserva su historial.</p></div><div className="archive-actions"><select value={cardId} onChange={event => setCardId(event.target.value)}>{cards.map(card => <option key={card.id} value={card.id}>{card.name}</option>)}</select><button type="button" onClick={archive}>Archivar</button>{message && <small className="positive">{message}</small>}</div></section>;
}

function CardDebtDetailsPanel({ csrf }: { csrf: string }) {
  const [cards, setCards] = useState<Card[]>([]);
  const [cardId, setCardId] = useState("");
  const [currency, setCurrency] = useState("COP");
  const [targetDebt, setTargetDebt] = useState("");
  const [date, setDate] = useState(new Date().toISOString().slice(0, 10));
  const load = () => api<Card[]>("/api/cards").then(items => { setCards(items); if (!cardId && items[0]) setCardId(String(items[0].id)); });
  useEffect(() => { load(); }, []);
  const selected = cards.find(card => card.id === Number(cardId));
  const currencies = selected?.currencies.map(item => item.currency) ?? ["COP", "USD"];
  useEffect(() => { if (currencies.length && !currencies.includes(currency)) setCurrency(currencies[0]); }, [cardId, cards]);
  async function adjust(event: FormEvent) { event.preventDefault(); if (!cardId) return; await api(`/api/cards/${cardId}/balance-adjustments`, { method: "POST", csrf, headers: { "Idempotency-Key": crypto.randomUUID() }, body: JSON.stringify({ currency, target_debt: targetDebt, adjustment_date: date, description: "Ajuste manual de deuda" }) }); setTargetDebt(""); load(); }
  return <section className="card detail-panel"><div className="detail-heading"><div><p className="eyebrow">Detalle</p><h3>Deuda de tarjeta</h3></div><select value={cardId} onChange={event => setCardId(event.target.value)}>{cards.map(card => <option key={card.id} value={card.id}>{card.name}</option>)}</select></div><form className="inline-form" onSubmit={adjust}><label>Moneda<select value={currency} onChange={event => setCurrency(event.target.value)}>{currencies.map(item => <option key={item}>{item}</option>)}</select></label><label>Deuda objetivo<input required type="number" min="0" step="0.01" value={targetDebt} onChange={event => setTargetDebt(event.target.value)} /></label><label>Fecha<input required type="date" value={date} onChange={event => setDate(event.target.value)} /></label><button>Registrar ajuste</button></form></section>;
}

function CardDetailsContent({ cardId }: { cardId: number }) {
  const [card, setCard] = useState<Card | null>(null);
  const [purchases, setPurchases] = useState<Purchase[]>([]);
  useEffect(() => { api<Card>(`/api/cards/${cardId}`).then(setCard); api<Purchase[]>(`/api/cards/${cardId}/purchases`).then(setPurchases); }, [cardId]);
  if (!card) return <p className="muted">Cargando detalle...</p>;
  const monthlyEstimate = purchases.reduce((sum, p) => sum + (p.installments[0] ? Number(p.installments[0].estimated_total) : Number(p.amount)), 0);
  return <><div className="detail-grid">{card.currencies.map(item => <div key={item.currency}><small>Deuda {item.currency}</small><strong>{money(item.outstanding_debt, item.currency)}</strong></div>)}</div>
    <p className="muted">Cuota estimada mensual: {money(monthlyEstimate, card.currencies[0]?.currency ?? "COP")}</p>
    <h4>Tasas mensuales</h4>{card.interest_rates.length === 0 ? <p className="muted">No hay tasas configuradas.</p> : card.interest_rates.map(rate => <div className="row" key={rate.id}><span>{rate.currency ?? "Todas las monedas"}<small>{rate.effective_from}{rate.effective_to ? ` a ${rate.effective_to}` : " en adelante"}</small></span><b>{Number(rate.monthly_rate) * 100}%</b></div>)}
    <h4>Compras recientes</h4>{purchases.map(purchase => <div className="row" key={purchase.id}><span>{purchase.description}<small>{purchase.installments_count} cuotas · {purchase.purchase_date} · tasa {Number(purchase.monthly_interest_rate) * 100}%</small></span><b>{money(purchase.amount, purchase.currency)}</b></div>)}</>;
}

function CardConfigurationPanel({ csrf, cardId, onArchived }: { csrf: string; cardId: number; onArchived: () => void }) {
  const [card, setCard] = useState<Card | null>(null);
  const [currency, setCurrency] = useState("COP");
  const [monthlyRate, setMonthlyRate] = useState("");
  const [effectiveFrom, setEffectiveFrom] = useState(new Date().toISOString().slice(0, 10));
  const [effectiveTo, setEffectiveTo] = useState("");
  const [targetDebt, setTargetDebt] = useState("");
  const [adjustmentDate, setAdjustmentDate] = useState(new Date().toISOString().slice(0, 10));
  useEffect(() => { api<Card>(`/api/cards/${cardId}`).then(value => { setCard(value); const selectedCurrency = value.currencies[0]?.currency ?? "COP"; setCurrency(selectedCurrency); const rate = value.interest_rates.find(item => item.currency === selectedCurrency || item.currency === null); if (rate) setMonthlyRate(String(Number(rate.monthly_rate) * 100)); }); }, [cardId]);
  async function saveRate(event: FormEvent) { event.preventDefault(); await api(`/api/cards/${cardId}/interest-rates`, { method: "POST", csrf, body: JSON.stringify({ currency, monthly_rate: String(Number(monthlyRate) / 100), effective_from: effectiveFrom, effective_to: effectiveTo || null }) }); setMonthlyRate(""); }
  async function adjustDebt(event: FormEvent) { event.preventDefault(); await api(`/api/cards/${cardId}/balance-adjustments`, { method: "POST", csrf, headers: { "Idempotency-Key": crypto.randomUUID() }, body: JSON.stringify({ currency, target_debt: targetDebt, adjustment_date: adjustmentDate, description: "Ajuste manual de deuda" }) }); setTargetDebt(""); }
  async function archive() { await api(`/api/cards/${cardId}/archive`, { method: "POST", csrf }); onArchived(); }
  if (!card) return <p className="muted">Cargando configuración...</p>;
  return <div className="stack"><p className="muted">Configurando: <strong>{card.name}</strong></p><form className="stack" onSubmit={saveRate}><h4>Interés mensual</h4><label>Moneda<select value={currency} onChange={event => setCurrency(event.target.value)}>{card.currencies.map(item => <option key={item.currency}>{item.currency}</option>)}</select></label><label>Tasa mensual (%)<input required type="number" min="0" step="0.00000001" placeholder="2.12345678" value={monthlyRate} onChange={event => setMonthlyRate(event.target.value)} /></label><label>Vigente desde<input required type="date" value={effectiveFrom} onChange={event => setEffectiveFrom(event.target.value)} /></label><label>Vigente hasta<input type="date" value={effectiveTo} onChange={event => setEffectiveTo(event.target.value)} /></label><button>Guardar tasa</button></form><form className="stack" onSubmit={adjustDebt}><h4>Ajustar deuda</h4><label>Deuda objetivo<input required type="number" min="0" step="0.01" value={targetDebt} onChange={event => setTargetDebt(event.target.value)} /></label><label>Fecha<input required type="date" value={adjustmentDate} onChange={event => setAdjustmentDate(event.target.value)} /></label><button>Registrar ajuste</button></form><button type="button" className="danger-button" onClick={archive}>Archivar tarjeta</button></div>;
}

function CardPaymentPanel({ csrf, cardId, onDone }: { csrf: string; cardId: number; onDone: () => void }) {
  const [accounts, setAccounts] = useState<Account[]>([]);
  const [card, setCard] = useState<Card | null>(null);
  const [lines, setLines] = useState<{ kind: string; amount: string; category_id: string; description: string }[]>([]);
  const [source, setSource] = useState("");
  const [payDate, setPayDate] = useState(new Date().toISOString().slice(0, 10));
  const [currency, setCurrency] = useState("");
  const [categories, setCategories] = useState<Category[]>([]);
  useEffect(() => { api<Card>(`/api/cards/${cardId}`).then(v => { setCard(v); if (v.currencies[0]) setCurrency(v.currencies[0].currency); }); api<Account[]>("/api/accounts").then(setAccounts); api<Category[]>("/api/categories").then(setCategories); }, [cardId]);
  function addLine() { setLines([...lines, { kind: "capital", amount: "", category_id: "", description: "" }]); }
  function updateLine(i: number, field: string, value: string) { const copy = [...lines]; copy[i] = { ...copy[i], [field]: value }; setLines(copy); }
  function removeLine(i: number) { setLines(lines.filter((_, idx) => idx !== i)); }
  const capitalTotal = lines.filter(l => l.kind === "capital").reduce((s, l) => s + (Number(l.amount) || 0), 0);
  const matching = accounts.filter(a => a.currency === currency);
  async function submit(event: FormEvent) {
    event.preventDefault();
    if (!source || capitalTotal <= 0) return;
    const extras = lines.filter(l => l.kind === "gasto" && l.amount).map(l => ({ amount: l.amount, category_id: Number(l.category_id) || categories[0]?.id, description: l.description || "Cargo adicional" }));
    await api(`/api/cards/${cardId}/payments`, { method: "POST", csrf, headers: { "Idempotency-Key": crypto.randomUUID() }, body: JSON.stringify({ card_id: cardId, source_account_id: Number(source), obligation_amount: String(capitalTotal), obligation_currency: currency, payment_date: payDate, extra_charges: extras.length > 0 ? extras : undefined }) });
    onDone();
  }
  if (!card) return <p className="muted">Cargando...</p>;
  return <div className="stack">
    <p className="muted">Pagando: <strong>{card.name}</strong> · Deuda {currency}: {money(card.currencies.find(c => c.currency === currency)?.outstanding_debt ?? "0", currency)}</p>
    <form className="stack" onSubmit={submit}>
      <label>Cuenta origen<select required value={source} onChange={e => setSource(e.target.value)}><option value="">Seleccionar</option>{matching.map(a => <option key={a.id} value={a.id}>{a.name}</option>)}</select></label>
      <label>Fecha<input required type="date" value={payDate} onChange={e => setPayDate(e.target.value)} /></label>
      <h4>Líneas de pago</h4>
      {lines.map((line, i) => <div className="row" key={i} style={{ flexWrap: "wrap", gap: 4 }}>
        <select value={line.kind} onChange={e => updateLine(i, "kind", e.target.value)} style={{ width: 80 }}><option value="capital">Capital</option><option value="gasto">Gasto</option></select>
        <input required type="number" min="0" step="0.01" placeholder="Monto" value={line.amount} onChange={e => updateLine(i, "amount", e.target.value)} style={{ width: 100 }} />
        {line.kind === "gasto" && <select value={line.category_id} onChange={e => updateLine(i, "category_id", e.target.value)} style={{ width: 120 }}>{categories.filter(c => c.kind !== "income").map(c => <option key={c.id} value={c.id}>{c.name}</option>)}</select>}
        <input placeholder="Descripción" value={line.description} onChange={e => updateLine(i, "description", e.target.value)} style={{ flex: 1 }} />
        <button type="button" onClick={() => removeLine(i)} style={{ width: 28 }}>×</button>
      </div>)}
      <button type="button" onClick={addLine}>+ Agregar línea</button>
      {capitalTotal > 0 && <p><strong>Total capital: {money(capitalTotal, currency)}</strong></p>}
      <button disabled={!source || capitalTotal <= 0}>Registrar pago</button>
    </form>
  </div>;
}

function CardsListContent({ csrf }: { csrf: string }) {
  const [cards, setCards] = useState<Card[]>([]);
  const [addOpen, setAddOpen] = useState(false);
  const [detailId, setDetailId] = useState<number | null>(null);
  const [configCardId, setConfigCardId] = useState<number | null>(null);
  const [payCardId, setPayCardId] = useState<number | null>(null);
  const [form, setForm] = useState({ name: "", issuing_bank: "", description: "", statement_closing_day: "15", currency: "COP", credit_limit: "" });
  const load = () => api<Card[]>("/api/cards").then(setCards);
  useEffect(() => { load(); }, []);
  async function submit(event: FormEvent) { event.preventDefault(); await api("/api/cards", { method: "POST", csrf, body: JSON.stringify({ name: form.name, issuing_bank: form.issuing_bank || null, description: form.description || null, statement_closing_day: Number(form.statement_closing_day), currencies: [{ currency: form.currency, credit_limit: form.credit_limit || null }] }) }); setAddOpen(false); setForm({ ...form, name: "" }); load(); }
  const totals = cards.reduce<Record<string, number>>((result, card) => { card.currencies.forEach(item => { result[item.currency] = (result[item.currency] ?? 0) + Number(item.outstanding_debt); }); return result; }, {});
  return <><header className="page-heading"><div><p className="eyebrow">Obligaciones</p><h2>Tarjetas</h2></div><button onClick={() => setAddOpen(true)}>Agregar tarjeta</button></header><section className="summary-strip"><strong>{cards.length} tarjetas</strong>{Object.entries(totals).map(([currency, amount]) => <span key={currency}>Deuda {currency}: {money(amount, currency)}</span>)}</section><section className="card list-card">{cards.length === 0 ? <p className="muted">No hay tarjetas registradas.</p> : cards.map(card => <div className="list-item" key={card.id}><div><strong>{card.name}</strong><small>Corte día {card.statement_closing_day} · {card.currencies.map(item => item.currency).join(" · ")}</small></div><b>{card.currencies.map(item => money(item.outstanding_debt, item.currency)).join(" / ")}</b><ActionMenu onDetails={() => setDetailId(card.id)} onConfigure={() => setConfigCardId(card.id)} onPay={() => setPayCardId(card.id)} /></div>)}</section><Modal open={addOpen} title="Agregar tarjeta" onClose={() => setAddOpen(false)}><form className="stack" onSubmit={submit}><label>Nombre<input required value={form.name} onChange={event => setForm({ ...form, name: event.target.value })} /></label><label>Día de corte<input required type="number" min="1" max="31" value={form.statement_closing_day} onChange={event => setForm({ ...form, statement_closing_day: event.target.value })} /></label><label>Moneda<select value={form.currency} onChange={event => setForm({ ...form, currency: event.target.value })}><option>COP</option><option>USD</option></select></label><button>Guardar tarjeta</button></form></Modal><Modal open={detailId !== null} title="Detalle de tarjeta" onClose={() => setDetailId(null)}>{detailId !== null && <CardDetailsContent cardId={detailId} />}</Modal><Modal open={configCardId !== null} title="Configurar tarjeta" onClose={() => setConfigCardId(null)}>{configCardId !== null && <CardConfigurationPanel csrf={csrf} cardId={configCardId} onArchived={() => { setConfigCardId(null); load(); }} />}</Modal><Modal open={payCardId !== null} title="Pagar tarjeta" onClose={() => setPayCardId(null)}>{payCardId !== null && <CardPaymentPanel csrf={csrf} cardId={payCardId} onDone={() => { setPayCardId(null); load(); }} />}</Modal></>;
}

function CardsView({ csrf }: { csrf: string }) {
  return <CardsListContent csrf={csrf} />;
}

function LoansLegacyView({ csrf }: { csrf: string }) {
  const [loans, setLoans] = useState<Loan[]>([]);
  const [accounts, setAccounts] = useState<Account[]>([]);
  const [selectedId, setSelectedId] = useState<number | null>(null);
  const [form, setForm] = useState({ name: "", principal_amount: "", currency: "COP", annual_effective_rate: "", term_months: "12", start_date: new Date().toISOString().slice(0, 10), first_payment_date: new Date().toISOString().slice(0, 10), source_account_id: "", record_as_income: false });
  const [payment, setPayment] = useState({ source_account_id: "", extra_principal: "", payment_date: new Date().toISOString().slice(0, 10) });
  const load = () => api<Loan[]>("/api/loans").then(items => { setLoans(items); if (!selectedId && items[0]) setSelectedId(items[0].id); });
  useEffect(() => { load(); api<Account[]>("/api/accounts").then(items => { setAccounts(items); if (items[0]) { setForm(value => ({ ...value, source_account_id: String(items[0].id) })); setPayment(value => ({ ...value, source_account_id: String(items[0].id) })); } }); }, []);
  async function submit(event: FormEvent) { event.preventDefault(); await api("/api/loans", { method: "POST", csrf, body: JSON.stringify({ ...form, principal_amount: form.principal_amount, annual_effective_rate: String(Number(form.annual_effective_rate) / 100), term_months: Number(form.term_months), source_account_id: form.source_account_id ? Number(form.source_account_id) : undefined }) }); setForm({ ...form, name: "", principal_amount: "", annual_effective_rate: "" }); load(); }
  async function pay(event: FormEvent) { event.preventDefault(); if (!selectedId) return; await api(`/api/loans/${selectedId}/payments`, { method: "POST", csrf, body: JSON.stringify({ source_account_id: Number(payment.source_account_id), payment_date: payment.payment_date, extra_principal: payment.extra_principal || "0" }) }); setPayment({ ...payment, extra_principal: "" }); load(); }
  const selected = loans.find(loan => loan.id === selectedId);
  return <><header className="page-heading"><div><p className="eyebrow">Deuda recibida</p><h2>Préstamos</h2></div></header><div className="split-grid"><section className="card"><h3>Agregar préstamo</h3><p className="muted">La tasa se ingresa como efectiva anual. Las cuotas se calculan mensualmente con amortización francesa.</p><form className="stack" onSubmit={submit}><label>Nombre<input required value={form.name} onChange={event => setForm({ ...form, name: event.target.value })} /></label><label>Principal<input required type="number" min="0" step="0.01" value={form.principal_amount} onChange={event => setForm({ ...form, principal_amount: event.target.value })} /></label><label>Moneda<select value={form.currency} onChange={event => setForm({ ...form, currency: event.target.value })}><option>COP</option><option>USD</option></select></label><label>Interés efectivo anual (%)<input required type="number" min="0" step="0.01" placeholder="12.68" value={form.annual_effective_rate} onChange={event => setForm({ ...form, annual_effective_rate: event.target.value })} /></label><label>Plazo en meses<input required type="number" min="1" max="360" value={form.term_months} onChange={event => setForm({ ...form, term_months: event.target.value })} /></label><label>Fecha de inicio<input required type="date" value={form.start_date} onChange={event => setForm({ ...form, start_date: event.target.value })} /></label><label>Primera cuota<input required type="date" value={form.first_payment_date} onChange={event => setForm({ ...form, first_payment_date: event.target.value })} /></label><label>Cuenta destino<select value={form.source_account_id} onChange={event => setForm({ ...form, source_account_id: event.target.value })}><option value="">Sin cuenta</option>{accounts.filter(account => account.currency === form.currency).map(account => <option key={account.id} value={account.id}>{account.name}</option>)}</select></label><label className="checkbox-label"><input type="checkbox" checked={form.record_as_income} onChange={event => setForm({ ...form, record_as_income: event.target.checked })} /> Registrar el desembolso como ingreso</label><button>Guardar préstamo</button></form></section><section className="card"><h3>Préstamos activos</h3>{loans.map(loan => <button className={selectedId === loan.id ? "card-item selected-card" : "card-item"} key={loan.id} onClick={() => setSelectedId(loan.id)}><div className="row"><span>{loan.name}<small>{loan.term_months} meses · EA {Number(loan.annual_effective_rate) * 100}%</small></span><b>{money(loan.outstanding_principal, loan.currency)}</b></div><div className="row subrow"><span>Cuota estimada</span><b>{loan.installments[0] ? money(loan.installments[0].total_amount, loan.currency) : "-"}</b></div></button>)}{selected && <><h3 className="section-gap">Registrar pago: {selected.name}</h3><form className="stack" onSubmit={pay}><label>Cuenta origen<select required value={payment.source_account_id} onChange={event => setPayment({ ...payment, source_account_id: event.target.value })}>{accounts.filter(account => account.currency === selected.currency).map(account => <option key={account.id} value={account.id}>{account.name}</option>)}</select></label><label>Abono adicional a capital<input type="number" min="0" step="0.01" value={payment.extra_principal} onChange={event => setPayment({ ...payment, extra_principal: event.target.value })} /></label><label>Fecha<input required type="date" value={payment.payment_date} onChange={event => setPayment({ ...payment, payment_date: event.target.value })} /></label><button>Registrar cuota</button></form></>}</section></div></>;
}

function LoanDetailsContent({ csrf, loanId }: { csrf: string; loanId: number }) {
  const [loan, setLoan] = useState<Loan | null>(null);
  const [accounts, setAccounts] = useState<Account[]>([]);
  const [accountId, setAccountId] = useState("");
  const [extra, setExtra] = useState("");
  const [scheduledAmount, setScheduledAmount] = useState("");
  const [date, setDate] = useState(new Date().toISOString().slice(0, 10));
  const load = () => api<Loan>(`/api/loans/${loanId}`).then(setLoan);
  useEffect(() => { load(); api<Account[]>("/api/accounts").then(values => { const matches = values.filter(account => account.currency === loan?.currency); setAccounts(matches); if (matches[0]) setAccountId(String(matches[0].id)); }); }, [loanId, loan?.currency]);
  async function pay(event: FormEvent) { event.preventDefault(); await api(`/api/loans/${loanId}/payments`, { method: "POST", csrf, body: JSON.stringify({ source_account_id: Number(accountId), payment_date: date, scheduled_amount: scheduledAmount || undefined, extra_principal: extra || "0" }) }); setExtra(""); setScheduledAmount(""); load(); }
  if (!loan) return <p className="muted">Cargando préstamo...</p>;
  return <><div className="detail-grid"><div><small>Saldo pendiente</small><strong>{money(loan.outstanding_principal, loan.currency)}</strong></div><div><small>Interés efectivo anual</small><strong>{Number(loan.annual_effective_rate) * 100}%</strong></div><div><small>Plazo</small><strong>{loan.term_months} meses</strong></div><div><small>Cuota estimada</small><strong>{loan.installments[0] ? money(loan.installments[0].total_amount, loan.currency) : "-"}</strong></div></div><form className="inline-form" onSubmit={pay}><label>Cuenta origen<select required value={accountId} onChange={event => setAccountId(event.target.value)}>{accounts.map(account => <option key={account.id} value={account.id}>{account.name}</option>)}</select></label><label>Monto a pagar<input type="number" min="0" step="0.01" value={scheduledAmount} onChange={event => setScheduledAmount(event.target.value)} placeholder={loan.installments[0] ? loan.installments[0].total_amount : ""} /></label><label>Abono extra a capital<input type="number" min="0" step="0.01" value={extra} onChange={event => setExtra(event.target.value)} /></label><label>Fecha<input required type="date" value={date} onChange={event => setDate(event.target.value)} /></label><button>Registrar pago</button></form><h4>Plan de cuotas</h4>{loan.installments.slice(0, 12).map(item => <div className="row" key={item.installment_number}><span>Cuota {item.installment_number}<small>{item.due_date} · {item.status}</small></span><b>{money(item.total_amount, loan.currency)}</b></div>)}</>;
}

function LoansListContent({ csrf }: { csrf: string }) {
  const [loans, setLoans] = useState<Loan[]>([]);
  const [accounts, setAccounts] = useState<Account[]>([]);
  const [addOpen, setAddOpen] = useState(false);
  const [detailId, setDetailId] = useState<number | null>(null);
  const [form, setForm] = useState({ name: "", principal_amount: "", currency: "COP", annual_effective_rate: "", term_months: "12", start_date: new Date().toISOString().slice(0, 10), first_payment_date: new Date().toISOString().slice(0, 10), source_account_id: "", record_as_income: false });
  const load = () => api<Loan[]>("/api/loans").then(setLoans);
  useEffect(() => { load(); api<Account[]>("/api/accounts").then(setAccounts); }, []);
  async function submit(event: FormEvent) { event.preventDefault(); await api("/api/loans", { method: "POST", csrf, body: JSON.stringify({ ...form, annual_effective_rate: String(Number(form.annual_effective_rate) / 100), term_months: Number(form.term_months), source_account_id: form.source_account_id ? Number(form.source_account_id) : undefined }) }); setAddOpen(false); setForm({ ...form, name: "", principal_amount: "", annual_effective_rate: "" }); load(); }
  const totals = loans.reduce<Record<string, number>>((result, loan) => { result[loan.currency] = (result[loan.currency] ?? 0) + Number(loan.outstanding_principal); return result; }, {});
  return <><header className="page-heading"><div><p className="eyebrow">Deuda recibida</p><h2>Préstamos</h2></div><button onClick={() => setAddOpen(true)}>Agregar préstamo</button></header><section className="summary-strip"><strong>{loans.length} préstamos</strong>{Object.entries(totals).map(([currency, amount]) => <span key={currency}>Pendiente {currency}: {money(amount, currency)}</span>)}</section><section className="card list-card">{loans.length === 0 ? <p className="muted">No hay préstamos registrados.</p> : loans.map(loan => <div className="list-item" key={loan.id}><div><strong>{loan.name}</strong><small>{loan.term_months} meses · EA {Number(loan.annual_effective_rate) * 100}%</small></div><b>{money(loan.outstanding_principal, loan.currency)}</b><ActionMenu onDetails={() => setDetailId(loan.id)} onConfigure={() => setDetailId(loan.id)} /></div>)}</section><Modal open={addOpen} title="Agregar préstamo" onClose={() => setAddOpen(false)}><form className="stack" onSubmit={submit}><label>Nombre<input required value={form.name} onChange={event => setForm({ ...form, name: event.target.value })} /></label><label>Principal<input required type="number" min="0" step="0.01" value={form.principal_amount} onChange={event => setForm({ ...form, principal_amount: event.target.value })} /></label><label>Moneda<select value={form.currency} onChange={event => setForm({ ...form, currency: event.target.value })}><option>COP</option><option>USD</option></select></label><label>Interés efectivo anual (%)<input required type="number" min="0" step="0.01" value={form.annual_effective_rate} onChange={event => setForm({ ...form, annual_effective_rate: event.target.value })} /></label><label>Plazo en meses<input required type="number" min="1" max="360" value={form.term_months} onChange={event => setForm({ ...form, term_months: event.target.value })} /></label><label>Fecha de inicio<input required type="date" value={form.start_date} onChange={event => setForm({ ...form, start_date: event.target.value })} /></label><label>Primera cuota<input required type="date" value={form.first_payment_date} onChange={event => setForm({ ...form, first_payment_date: event.target.value })} /></label><label>Cuenta destino<select value={form.source_account_id} onChange={event => setForm({ ...form, source_account_id: event.target.value })}><option value="">Sin cuenta</option>{accounts.filter(account => account.currency === form.currency).map(account => <option key={account.id} value={account.id}>{account.name}</option>)}</select></label><label className="checkbox-label"><input type="checkbox" checked={form.record_as_income} onChange={event => setForm({ ...form, record_as_income: event.target.checked })} /> Registrar como ingreso</label><button>Guardar préstamo</button></form></Modal><Modal open={detailId !== null} title="Detalle y pagos del préstamo" onClose={() => setDetailId(null)}>{detailId !== null && <LoanDetailsContent csrf={csrf} loanId={detailId} />}</Modal></>;
}

function LoansView({ csrf }: { csrf: string }) {
  return <LoansListContent csrf={csrf} />;
}

function BudgetConsumptionPanel({ csrf, initialId }: { csrf: string; initialId?: string }) {
  const [budgets, setBudgets] = useState<Budget[]>([]);
  const [budgetId, setBudgetId] = useState(initialId ?? "");
  const [summary, setSummary] = useState<{ accumulated_budget: string; actual_spending: string; balance: string; percentage_used: string; excess: string; daily_history: { date: string; amount: string }[] } | null>(null);
  const load = () => api<Budget[]>("/api/budgets").then(items => { setBudgets(items); if (!budgetId && items[0]) setBudgetId(String(items[0].id)); });
  useEffect(() => { load(); }, []);
  useEffect(() => { if (budgetId) api<typeof summary>(`/api/budgets/${budgetId}/summary`).then(setSummary); }, [budgetId]);
  const percent = Math.max(0, Number(summary?.percentage_used ?? 0));
  return <section className="card detail-panel consumption-panel"><div className="detail-heading"><div><p className="eyebrow">Seguimiento</p><h3>Consumo del presupuesto</h3></div><select value={budgetId} onChange={event => setBudgetId(event.target.value)}>{budgets.map(budget => <option key={budget.id} value={budget.id}>{budget.name} · {budget.budget_type === "daily" ? "diario" : "máximo"}</option>)}</select></div>{summary && <><div className="budget-progress-label"><span>{summary.percentage_used}% consumido</span><span>{summary.actual_spending} / {summary.accumulated_budget}</span></div><div className="budget-progress"><div style={{ width: `${Math.min(percent, 100)}%` }} /></div><div className="detail-grid"><div><small>Acumulado permitido</small><strong>{summary.accumulated_budget}</strong></div><div><small>Gasto real</small><strong>{summary.actual_spending}</strong></div><div><small>Saldo</small><strong>{summary.balance}</strong></div><div><small>Exceso</small><strong>{summary.excess}</strong></div></div><h4>Evolución diaria</h4>{summary.daily_history.length === 0 ? <p className="muted">Aún no hay consumo en este período.</p> : summary.daily_history.map(item => <div className="row" key={item.date}><span>{item.date}</span><b>{item.amount}</b></div>)}</>}</section>;
}

function BudgetTransactionHistoryPanel({ csrf, initialId }: { csrf: string; initialId?: string }) {
  const [budgets, setBudgets] = useState<Budget[]>([]);
  const [budgetId, setBudgetId] = useState(initialId ?? "");
  const [history, setHistory] = useState<{ date: string; amount: string; transactions: { id: number; description: string | null; amount: string }[] }[]>([]);
  useEffect(() => { api<Budget[]>("/api/budgets").then(items => { setBudgets(items); if (items[0]) setBudgetId(String(items[0].id)); }); }, []);
  useEffect(() => { if (budgetId) api<{ daily_history: typeof history }>(`/api/budgets/${budgetId}/summary`).then(data => setHistory(data.daily_history)); }, [budgetId]);
  return <section className="card detail-panel"><div className="detail-heading"><div><p className="eyebrow">Trazabilidad</p><h3>Transacciones que consumen el presupuesto</h3></div><select value={budgetId} onChange={event => setBudgetId(event.target.value)}>{budgets.map(budget => <option key={budget.id} value={budget.id}>{budget.name}</option>)}</select></div>{history.length === 0 ? <p className="muted">No hay transacciones en el período.</p> : history.map(day => <div className="budget-day" key={day.date}><div className="row"><strong>{day.date}</strong><b>{day.amount}</b></div>{day.transactions.map(transaction => <div className="budget-transaction" key={transaction.id}><span>{transaction.description || "Sin descripción"}</span><span>{transaction.amount}</span></div>)}</div>)}</section>;
}

function BudgetDetailsPanel({ csrf, initialId, onArchived }: { csrf: string; initialId?: string; onArchived: () => void }) {
  const [budgetId, setBudgetId] = useState(initialId ?? "");
  const [budget, setBudget] = useState<Budget | null>(null);
  const [summary, setSummary] = useState<{ accumulated_budget: string; actual_spending: string; balance: string; percentage_used: string; excess: string; period_start: string; period_end: string; daily_history: { date: string; amount: string }[] } | null>(null);
  const [targetAmount, setTargetAmount] = useState("");
  useEffect(() => { if (initialId) { setBudgetId(initialId); api<Budget>(`/api/budgets/${initialId}`).then(value => { setBudget(value); setTargetAmount(value.target_amount); }); api<typeof summary>(`/api/budgets/${initialId}/summary`).then(setSummary); } }, [initialId]);
  async function update(event: FormEvent) { event.preventDefault(); if (!budgetId) return; await api(`/api/budgets/${budgetId}`, { method: "PATCH", csrf, body: JSON.stringify({ target_amount: targetAmount }) }); api<Budget>(`/api/budgets/${budgetId}`).then(value => { setBudget(value); setTargetAmount(value.target_amount); }); api<typeof summary>(`/api/budgets/${budgetId}/summary`).then(setSummary); }
  async function archive() { await api(`/api/budgets/${budgetId}/archive`, { method: "POST", csrf }); onArchived(); }
  const periodLabel = (type: string) => ({ daily: "Diario", weekly: "Semanal", monthly: "Mensual", custom: "Personalizado" })[type] ?? type;
  return <section className="card detail-panel">{budget && <><div className="detail-heading"><div><p className="eyebrow">Detalle</p><h3>{budget.name}</h3></div></div>
    <div className="detail-grid"><div><small>Tipo</small><strong>{budget.budget_type === "daily" ? "Acumulativo diario" : "Máximo"} · {periodLabel(budget.period_type)}</strong></div><div><small>Alcance</small><strong>{budget.scope === "general" ? "General" : budget.scope === "account" ? "Cuenta" : "Tarjeta"} · {budget.spending_type === "debit" ? "Débito" : "Crédito"}</strong></div><div><small>Moneda</small><strong>{budget.currency}</strong></div><div><small>Monto objetivo</small><strong>{money(budget.target_amount, budget.currency)}</strong></div></div>
    {summary && <div className="detail-grid" style={{ marginTop: 8 }}><div><small>Período</small><strong>{summary.period_start} a {summary.period_end}</strong></div><div><small>Acumulado</small><strong>{summary.accumulated_budget}</strong></div><div><small>Gastado</small><strong>{summary.actual_spending}</strong></div><div><small>Saldo</small><strong>{summary.balance}</strong></div></div>}
    {summary && <div style={{ marginTop: 8 }}><div className="row"><span>Uso ({summary.percentage_used}%)</span><b>{summary.excess === "0.00" ? "Dentro del límite" : `Exceso: ${summary.excess}`}</b></div><div className="budget-progress"><div style={{ width: `${Math.min(Number(summary.percentage_used), 200)}%` }} /></div></div>}
    <form className="inline-form" onSubmit={update}><label>Nuevo límite<input required type="number" min="1" step="0.01" value={targetAmount} onChange={event => setTargetAmount(event.target.value)} /></label><button>Guardar</button></form>
    <button type="button" className="danger-button" onClick={archive} style={{ marginTop: 12 }}>Archivar presupuesto</button></>}</section>;
}

function BudgetsWorkspace({ csrf }: { csrf: string }) {
  const [budgets, setBudgets] = useState<Budget[]>([]);
  const [summaries, setSummaries] = useState<Record<number, { actual_spending: string; balance: string }>>({});
  const [form, setForm] = useState({ name: "", budget_type: "maximum", target_amount: "", spending_type: "debit", start_date: new Date().toISOString().slice(0, 8) + "01", end_date: new Date().toISOString().slice(0, 10) });
  const load = () => api<Budget[]>("/api/budgets").then(setBudgets);
  useEffect(() => { load(); }, []);
  async function submit(event: FormEvent) { event.preventDefault(); await api("/api/budgets", { method: "POST", csrf, body: JSON.stringify({ ...form, currency: "COP", period_type: "monthly", scope: "general" }) }); setForm({ ...form, name: "", target_amount: "" }); load(); }
  async function showSummary(id: number) { const summary = await api<{ actual_spending: string; balance: string }>(`/api/budgets/${id}/summary`); setSummaries({ ...summaries, [id]: summary }); }
  return <><header className="page-heading"><div><p className="eyebrow">Control flexible</p><h2>Presupuestos</h2></div></header><div className="split-grid"><section className="card"><h3>Nuevo presupuesto COP</h3><form className="stack" onSubmit={submit}><label>Nombre<input required value={form.name} onChange={event => setForm({ ...form, name: event.target.value })} /></label><label>Tipo<select value={form.budget_type} onChange={event => setForm({ ...form, budget_type: event.target.value })}><option value="maximum">Máximo</option><option value="daily">Acumulativo diario</option></select></label><label>Monto objetivo<input required type="number" min="1" value={form.target_amount} onChange={event => setForm({ ...form, target_amount: event.target.value })} /></label><label>Tipo de gasto<select value={form.spending_type} onChange={event => setForm({ ...form, spending_type: event.target.value })}><option value="debit">Débito</option><option value="credit">Crédito</option></select></label><button>Crear presupuesto</button></form></section><section className="card"><h3>Presupuestos activos</h3>{budgets.map(budget => <div className="row" key={budget.id}><span>{budget.name}<small>{budget.budget_type === "daily" ? "Diario" : "Máximo"} · {budget.spending_type}{summaries[budget.id] && ` · Gastado ${money(summaries[budget.id].actual_spending, budget.currency)}`}</small></span><button className="link-button" onClick={() => showSummary(budget.id)}>Ver resumen</button></div>)}</section></div></>;
}

function BudgetsListContent({ csrf }: { csrf: string }) {
  const [budgets, setBudgets] = useState<Budget[]>([]);
  const [addOpen, setAddOpen] = useState(false);
  const [detailId, setDetailId] = useState<number | null>(null);
  const [configOpen, setConfigOpen] = useState(false);
  const [form, setForm] = useState({ name: "", budget_type: "maximum", target_amount: "", spending_type: "debit", start_date: new Date().toISOString().slice(0, 8) + "01", end_date: new Date().toISOString().slice(0, 10) });
  const load = () => api<Budget[]>("/api/budgets").then(setBudgets);
  useEffect(() => { load(); }, []);
  async function submit(event: FormEvent) { event.preventDefault(); await api("/api/budgets", { method: "POST", csrf, body: JSON.stringify({ ...form, currency: "COP", period_type: "monthly", scope: "general" }) }); setAddOpen(false); setForm({ ...form, name: "", target_amount: "" }); load(); }
  const total = budgets.reduce((sum, budget) => sum + Number(budget.target_amount), 0);
  return <><header className="page-heading"><div><p className="eyebrow">Control flexible</p><h2>Presupuestos</h2></div><button onClick={() => setAddOpen(true)}>Agregar presupuesto</button></header><section className="summary-strip"><strong>{budgets.length} presupuestos</strong><span>Total configurado COP: {money(total, "COP")}</span></section><section className="card list-card">{budgets.length === 0 ? <p className="muted">No hay presupuestos registrados.</p> : budgets.map(budget => <div className="list-item" key={budget.id}><div><strong>{budget.name}</strong><small>{budget.budget_type === "daily" ? "Diario" : "Máximo"} · {budget.spending_type} · {budget.start_date} a {budget.end_date}</small></div><b>{money(budget.target_amount, budget.currency)}</b><ActionMenu onDetails={() => setDetailId(budget.id)} onConfigure={() => setConfigOpen(true)} /></div>)}</section><Modal open={addOpen} title="Agregar presupuesto" onClose={() => setAddOpen(false)}><form className="stack" onSubmit={submit}><label>Nombre<input required value={form.name} onChange={event => setForm({ ...form, name: event.target.value })} /></label><label>Tipo<select value={form.budget_type} onChange={event => setForm({ ...form, budget_type: event.target.value })}><option value="maximum">Máximo</option><option value="daily">Acumulativo diario</option></select></label><label>Monto objetivo<input required type="number" min="1" step="0.01" value={form.target_amount} onChange={event => setForm({ ...form, target_amount: event.target.value })} /></label><label>Tipo de gasto<select value={form.spending_type} onChange={event => setForm({ ...form, spending_type: event.target.value })}><option value="debit">Débito</option><option value="credit">Crédito</option></select></label><label>Desde<input required type="date" value={form.start_date} onChange={event => setForm({ ...form, start_date: event.target.value })} /></label><label>Hasta<input required type="date" value={form.end_date} onChange={event => setForm({ ...form, end_date: event.target.value })} /></label><button>Guardar presupuesto</button></form></Modal><Modal open={detailId !== null} title="Seguimiento del presupuesto" onClose={() => setDetailId(null)}>{detailId !== null && <><BudgetConsumptionPanel csrf={csrf} /><BudgetTransactionHistoryPanel csrf={csrf} /></>}</Modal><Modal open={configOpen} title="Configurar presupuestos" onClose={() => setConfigOpen(false)}><BudgetDetailsPanel csrf={csrf} onArchived={() => { setConfigOpen(false); load(); }} /></Modal></>;
}

function ContextualBudgetsListContent({ csrf }: { csrf: string }) {
  const [budgets, setBudgets] = useState<Budget[]>([]);
  const [accounts, setAccounts] = useState<Account[]>([]);
  const [cards, setCards] = useState<Card[]>([]);
  const [addOpen, setAddOpen] = useState(false);
  const [detailId, setDetailId] = useState<number | null>(null);
  const [configId, setConfigId] = useState<number | null>(null);
  const [form, setForm] = useState({ name: "", budget_type: "maximum", target_amount: "", currency: "COP", period_type: "monthly", scope: "general", spending_type: "debit", category_id: "", account_id: "", card_id: "", start_date: new Date().toISOString().slice(0, 10), end_date: new Date().toISOString().slice(0, 10) });
  const load = () => api<Budget[]>("/api/budgets").then(setBudgets);
  useEffect(() => { load(); api<Account[]>("/api/accounts").then(setAccounts); api<Card[]>("/api/cards").then(setCards); }, []);
  async function submit(event: FormEvent) {
    event.preventDefault();
    const body: Record<string, unknown> = { ...form, target_amount: form.target_amount, scope: form.scope };
    if (form.scope === "account") {
      if (!form.account_id) return;
      body.account_id = Number(form.account_id);
      body.spending_type = "debit";
    } else {
      delete body.account_id;
    }
    if (form.scope === "card") {
      if (!form.card_id) return;
      body.card_id = Number(form.card_id);
      body.spending_type = "credit";
    } else {
      delete body.card_id;
    }
    delete body.category_id;
    if (form.period_type !== "custom") {
      delete body.start_date;
      delete body.end_date;
    }
    await api("/api/budgets", { method: "POST", csrf, body: JSON.stringify(body) });
    setAddOpen(false);
    setForm({ ...form, name: "", target_amount: "" });
    load();
  }
  const totals = budgets.reduce<Record<string, number>>((result, budget) => {
    result[budget.currency] = (result[budget.currency] ?? 0) + Number(budget.target_amount);
    return result;
  }, {});
  const scopeLabel = (budget: Budget) => {
    if (budget.scope === "account") { const a = accounts.find(item => item.id === budget.account_id); return a ? a.name : "Cuenta"; }
    if (budget.scope === "card") { const c = cards.find(item => item.id === budget.card_id); return c ? c.name : "Tarjeta"; }
    return "General";
  };
  const periodLabel = (budget: Budget) =>
    budget.period_type !== "custom"
      ? { daily: "Diario", weekly: "Semanal", monthly: "Mensual" }[budget.period_type] ?? budget.period_type
      : `${budget.start_date} a ${budget.end_date}`;
  const filteredAccounts = accounts.filter(item => item.currency === form.currency);
  const filteredCards = cards.filter(item => item.currencies.some(c => c.currency === form.currency));
  return (
    <>
      <header className="page-heading"><div><p className="eyebrow">Control flexible</p><h2>Presupuestos</h2></div><button onClick={() => setAddOpen(true)}>Agregar presupuesto</button></header>
      <section className="summary-strip">
        <strong>{budgets.length} presupuestos</strong>
        {Object.entries(totals).map(([currency, amount]) => <span key={currency}>Configurado {currency}: {money(amount, currency)}</span>)}
      </section>
      <section className="card list-card">
        {budgets.length === 0
          ? <p className="muted">No hay presupuestos registrados.</p>
          : budgets.map(budget => (
            <div className="list-item" key={budget.id}>
              <div><strong>{budget.name}</strong><small>{budget.budget_type === "daily" ? "Diario" : "Máximo"} · {budget.spending_type} · {periodLabel(budget)} · {scopeLabel(budget)}</small></div>
              <b>{money(budget.target_amount, budget.currency)}</b>
              <ActionMenu onDetails={() => setDetailId(budget.id)} onConfigure={() => setConfigId(budget.id)} />
            </div>
          ))}
      </section>
      <Modal open={addOpen} title="Agregar presupuesto" onClose={() => setAddOpen(false)}>
        <form className="stack" onSubmit={submit}>
          <label>Nombre<input required value={form.name} onChange={event => setForm({ ...form, name: event.target.value })} /></label>
          <label>Tipo<select value={form.budget_type} onChange={event => setForm({ ...form, budget_type: event.target.value })}><option value="maximum">Máximo</option><option value="daily">Acumulativo diario</option></select></label>
          <label>Monto objetivo<input required type="number" min="1" step="0.01" value={form.target_amount} onChange={event => setForm({ ...form, target_amount: event.target.value })} /></label>
          <label>Moneda<select value={form.currency} onChange={event => setForm({ ...form, currency: event.target.value })}><option>COP</option><option>USD</option></select></label>
          <label>Período<select value={form.period_type} onChange={event => setForm({ ...form, period_type: event.target.value })}><option value="monthly">Mensual</option><option value="weekly">Semanal</option><option value="daily">Diario</option><option value="custom">Personalizado</option></select></label>
          <label>Alcance<select value={form.scope} onChange={event => { const scope = event.target.value; const updates: Record<string, string> = { scope, account_id: "", card_id: "" }; if (scope === "account" && filteredAccounts.length > 0) updates.account_id = String(filteredAccounts[0].id); if (scope === "card" && filteredCards.length > 0) updates.card_id = String(filteredCards[0].id); setForm({ ...form, ...updates }); }}><option value="general">General</option><option value="account">Cuenta</option><option value="card">Tarjeta</option></select></label>
          {form.scope === "account" && <label>Cuenta<select value={form.account_id} onChange={event => setForm({ ...form, account_id: event.target.value })}>{filteredAccounts.length === 0 ? <option value="">Sin cuentas en {form.currency}</option> : filteredAccounts.map(account => <option key={account.id} value={account.id}>{account.name}</option>)}</select></label>}
          {form.scope === "card" && <label>Tarjeta<select value={form.card_id} onChange={event => setForm({ ...form, card_id: event.target.value })}>{filteredCards.length === 0 ? <option value="">Sin tarjetas en {form.currency}</option> : filteredCards.map(card => <option key={card.id} value={card.id}>{card.name}</option>)}</select></label>}
{form.scope === "general" && <label>Tipo de gasto<select value={form.spending_type} onChange={event => setForm({ ...form, spending_type: event.target.value })}><option value="debit">Débito</option><option value="credit">Crédito</option></select></label>}
          {form.period_type === "custom" && (
            <>
              <label>Desde<input required type="date" value={form.start_date} onChange={event => setForm({ ...form, start_date: event.target.value })} /></label>
              <label>Hasta<input required type="date" value={form.end_date} onChange={event => setForm({ ...form, end_date: event.target.value })} /></label>
            </>
          )}
          <button>Guardar presupuesto</button>
        </form>
      </Modal>
      <Modal open={detailId !== null} title="Detalle de presupuesto" onClose={() => setDetailId(null)}>
        {detailId !== null && <BudgetDetailsPanel csrf={csrf} initialId={String(detailId)} onArchived={() => { setDetailId(null); load(); }} />}
      </Modal>
      <Modal open={configId !== null} title="Configurar presupuesto" onClose={() => setConfigId(null)}>
        {configId !== null && <BudgetDetailsPanel csrf={csrf} initialId={String(configId)} onArchived={() => { setConfigId(null); load(); }} />}
      </Modal>
    </>
  );
}

function BudgetsView({ csrf }: { csrf: string }) {
  return <ContextualBudgetsListContent csrf={csrf} />;
}

function SettingsView({ csrf, user }: { csrf: string; user: Session["user"] }) {
  const [name, setName] = useState(user.display_name);
  const [currency, setCurrency] = useState("COP");
  const [timezone, setTimezone] = useState("America/Bogota");
  useEffect(() => { api<{ reporting_currency: string; timezone: string }>("/api/settings").then(data => { setCurrency(data.reporting_currency); setTimezone(data.timezone); }); }, []);
  async function save(event: FormEvent) { event.preventDefault(); await api("/api/auth/profile", { method: "PATCH", csrf, body: JSON.stringify({ display_name: name }) }); await api("/api/settings", { method: "PATCH", csrf, body: JSON.stringify({ reporting_currency: currency, timezone }) }); }
  return <section className="card"><p className="eyebrow">Perfil</p><h2>Configuración</h2><p className="muted">{user.email}</p><form className="stack settings-form" onSubmit={save}><label>Nombre<input value={name} onChange={event => setName(event.target.value)} /></label><label>Moneda de reportes<select value={currency} onChange={event => setCurrency(event.target.value)}><option>COP</option><option>USD</option></select></label><label>Zona horaria<input value={timezone} onChange={event => setTimezone(event.target.value)} /></label><button>Guardar cambios</button></form></section>;
}

function App() {
  const [session, setSession] = useState<Session | null>(null);
  const [view, setView] = useState<View>("dashboard");
  useEffect(() => { api<Session>("/api/auth/session").then(setSession).catch(() => undefined); }, []);
  if (!session) return <Auth onSession={setSession} />;
  const activeSession = session;
  const views: Record<View, ReactNode> = {
    dashboard: <DashboardView />,
    transactions: <UnifiedMovementsView csrf={activeSession.csrf_token} />,
    accounts: <AccountsView csrf={activeSession.csrf_token} />,
    cards: <CardsView csrf={activeSession.csrf_token} />,
    loans: <LoansView csrf={activeSession.csrf_token} />,
    budgets: <BudgetsView csrf={activeSession.csrf_token} />,
    settings: <SettingsView csrf={activeSession.csrf_token} user={activeSession.user} />,
  };
  async function logout() { await api("/api/auth/logout", { method: "POST", csrf: activeSession.csrf_token }); setSession(null); }
  const navigation: [View, string][] = [["dashboard", "Resumen"], ["transactions", "Movimientos"], ["accounts", "Cuentas"], ["cards", "Tarjetas"], ["loans", "Préstamos"], ["budgets", "Presupuestos"], ["settings", "Configuración"]];
  return <div className="app-shell"><aside className="sidebar"><div><p className="eyebrow">Mis finanzas</p><strong className="brand">Control</strong></div><nav>{navigation.map(([key, label]) => <button className={view === key ? "nav-item active" : "nav-item"} key={key} onClick={() => setView(key)}>{label}</button>)}</nav><button className="link-button sidebar-exit" onClick={logout}>Cerrar sesión</button></aside><main className="content"><div className="mobile-top"><strong>Control</strong><button className="link-button" onClick={logout}>Salir</button></div>{views[view]}</main></div>;
}

createRoot(document.getElementById("root")!).render(<StrictMode><App /></StrictMode>);
